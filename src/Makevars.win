# -*- Makefile -*-

# Native compute helpers call LAPACK/BLAS entry points.
# Link explicitly on Windows to avoid unresolved symbol failures.
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# New plot-inference entries include request-only native headers. Track them
# explicitly so an incremental install cannot retain a stale entry object.
all: $(SHLIB)
np.o: np_plot_regression_gradient_projection.h np_plot_beta_moment_entry.h
jksum.o: np_plot_alllarge_derivative.h np_plot_gate_dispatch.h np_plot_beta_concentration_score.h np_plot_nn_response_jet.h np_plot_beta_moment_weights.h np_plot_lp_precision_certificate.h np_plot_lsq_precision_propagation.h np_plot_ann_kernel_terms.h np_plot_beta_pdf_agreement.h np_plot_ann_cdf_terms.h np_plot_ann_rank_decode.h
