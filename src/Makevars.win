# -*- Makefile -*-  vim : ft = make

ifeq "$(MPI_HOME)" ""
MPI_HOME = c:/Program Files/Microsoft MPI
endif

PKG_CPPFLAGS = -I"$(MPI_HOME)/Inc" -DMPI2 -DWin32

all: $(SHLIB)

ifeq "$(WIN)" "64" 
PKG_LIBS     = -L. -lmsmpi64 $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
$(SHLIB): libmsmpi64.a
else
PKG_LIBS     = "$(MPI_HOME)/Lib/i386/msmpi.lib" $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
endif

##msmpi.def:
##	gendef -r c:/Windows/System32/msmpi.dll
libmsmpi64.a: msmpi.def
	$(DLLTOOL) -k -d msmpi.def -l libmsmpi64.a -D msmpi.dll $(DT_ARCH)

# New plot-inference entries include request-only native headers. Track them
# explicitly so an incremental install cannot retain a stale entry object.
all: $(SHLIB)
np.o: np_plot_regression_gradient_projection.h np_plot_beta_moment_entry.h
jksum.o: np_plot_alllarge_derivative.h np_plot_gate_dispatch.h np_plot_beta_concentration_score.h np_plot_nn_response_jet.h np_plot_beta_moment_weights.h np_plot_lp_precision_certificate.h np_plot_lsq_precision_propagation.h np_plot_ann_kernel_terms.h np_plot_beta_pdf_agreement.h np_plot_ann_cdf_terms.h np_plot_ann_rank_decode.h

# Conditional categorical-policy instantiations share canonical source bodies.
np.o: conditional_literal.h $(wildcard conditional_literal/entry_*.inc)
jksum.o categorical_profile_tile.o: conditional_literal.h $(wildcard conditional_literal/jksum_*.inc)
